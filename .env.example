# ==============================================================================
# AUTONOMOUS ANDROID CONTROLLER (.env.example)
# Multi-Provider 19-Key Resilient Failover Configuration Template
# Copy this file to .env and populate with your personal API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# TIER 1: Primary Flash Low-Latency Endpoints (7 Independent Keys)
# High-efficiency endpoints for fast multimodal perception and reasoning.
# ------------------------------------------------------------------------------
PRIMARY_FLASH_KEY_1=YOUR_PRIMARY_FLASH_API_KEY_1_HERE
PRIMARY_FLASH_KEY_2=YOUR_PRIMARY_FLASH_API_KEY_2_HERE
PRIMARY_FLASH_KEY_3=YOUR_PRIMARY_FLASH_API_KEY_3_HERE
PRIMARY_FLASH_KEY_4=YOUR_PRIMARY_FLASH_API_KEY_4_HERE
PRIMARY_FLASH_KEY_5=YOUR_PRIMARY_FLASH_API_KEY_5_HERE
PRIMARY_FLASH_KEY_6=YOUR_PRIMARY_FLASH_API_KEY_6_HERE
PRIMARY_FLASH_KEY_7=YOUR_PRIMARY_FLASH_API_KEY_7_HERE
PRIMARY_FLASH_API_KEY=YOUR_PRIMARY_FLASH_FALLBACK_KEY_HERE

# Optional: Override primary model list (comma-separated)
PRIMARY_FLASH_MODELS=flash-lite-latest,flash-latest,flash-preview

# ------------------------------------------------------------------------------
# TIER 2: Fast Open-Source Inference via Groq (5 Independent Keys)
# High token throughput for sub-second intent classification and parsing.
# ------------------------------------------------------------------------------
GROQ_API_KEY_1=YOUR_GROQ_API_KEY_1_HERE
GROQ_API_KEY_2=YOUR_GROQ_API_KEY_2_HERE
GROQ_API_KEY_3=YOUR_GROQ_API_KEY_3_HERE
GROQ_API_KEY_4=YOUR_GROQ_API_KEY_4_HERE
GROQ_API_KEY_5=YOUR_GROQ_API_KEY_5_HERE
GROQ_API_KEY=YOUR_GROQ_FALLBACK_KEY_HERE

# ------------------------------------------------------------------------------
# TIER 3: Universal Fallback Pool via OpenRouter (7 Independent Keys)
# Access to diverse open-weights models with automated key rotation.
# ------------------------------------------------------------------------------
OR_KEY_1=YOUR_OPENROUTER_API_KEY_1_HERE
OR_KEY_2=YOUR_OPENROUTER_API_KEY_2_HERE
OR_KEY_3=YOUR_OPENROUTER_API_KEY_3_HERE
OR_KEY_4=YOUR_OPENROUTER_API_KEY_4_HERE
OR_KEY_5=YOUR_OPENROUTER_API_KEY_5_HERE
OR_KEY_6=YOUR_OPENROUTER_API_KEY_6_HERE
OR_KEY_7=YOUR_OPENROUTER_API_KEY_7_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_FALLBACK_KEY_HERE

# ------------------------------------------------------------------------------
# OPTIONAL: Real-Time Web Search Integration (Serper with Tavily fallback)
# ------------------------------------------------------------------------------
SERPER_API_KEY=YOUR_SERPER_API_KEY_HERE
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# ------------------------------------------------------------------------------
# DEVICE CONNECTION & HARDWARE CONFIGURATION
# ------------------------------------------------------------------------------
# ADB Target Address: Leave blank when running directly on-device in Termux (rish).
# For remote control over Wi-Fi ADB, specify host:port (e.g. 127.0.0.1:5555).
ADB_TARGET=127.0.0.1:5555

# ADB Binary executable path: Defaults to 'adb' in PATH.
ADB_BIN=adb

# Target Device Profile (Default: Samsung Galaxy M56 / SM-M566B)
DEVICE_MODEL=SM-M566B
AUDIO_STREAM_INDEX=3
